{
  "$description": "Tia Clara — design tokens (formato W3C DTCG). Primitivos -> semânticos. Não crie cores fora daqui.",
  "cor": {
    "primitivo": {
      "pinho":        { "$type": "color", "$value": "#1E3B33", "$description": "Guardiã. Cor-mãe da marca." },
      "pinho-profundo": { "$type": "color", "$value": "#142A24", "$description": "Fundos escuros de alto contraste, modo escuro." },
      "musgo":        { "$type": "color", "$value": "#56625A", "$description": "Texto secundário sobre claro (5,5:1 no Linho)." },
      "linho":        { "$type": "color", "$value": "#F4EEE3", "$description": "Fundo padrão. Calor sem ser bege-doce." },
      "papel":        { "$type": "color", "$value": "#FBF8F2", "$description": "Superfície elevada (cartões) sobre Linho." },
      "salvia":       { "$type": "color", "$value": "#DDE1D4", "$description": "Superfície secundária, blocos de apoio." },
      "latao":        { "$type": "color", "$value": "#C6A15E", "$description": "O metal da plaquinha. Só sobre Pinho (5:1). Nunca texto sobre claro." },
      "argila":       { "$type": "color", "$value": "#A94E2A", "$description": "Cuidadora: calor, CTA, destaque. Texto OK sobre Linho (4,8:1) e Papel (5,2:1)." },
      "argila-clara": { "$type": "color", "$value": "#E7B89A", "$description": "Argila legível sobre Pinho (6,8:1)." },
      "tinta":        { "$type": "color", "$value": "#1B1D1A", "$description": "Texto longo opcional; produção em preto." }
    },
    "semantico": {
      "fundo":            { "padrao": { "$type": "color", "$value": "{cor.primitivo.linho}" },
                            "elevado": { "$type": "color", "$value": "{cor.primitivo.papel}" },
                            "apoio": { "$type": "color", "$value": "{cor.primitivo.salvia}" },
                            "inverso": { "$type": "color", "$value": "{cor.primitivo.pinho}" },
                            "inverso-profundo": { "$type": "color", "$value": "{cor.primitivo.pinho-profundo}" } },
      "texto":            { "primario": { "$type": "color", "$value": "{cor.primitivo.pinho}" },
                            "secundario": { "$type": "color", "$value": "{cor.primitivo.musgo}" },
                            "inverso": { "$type": "color", "$value": "{cor.primitivo.linho}" },
                            "inverso-secundario": { "$type": "color", "$value": "{cor.primitivo.salvia}" },
                            "destaque": { "$type": "color", "$value": "{cor.primitivo.argila}" },
                            "destaque-inverso": { "$type": "color", "$value": "{cor.primitivo.argila-clara}" },
                            "metal-inverso": { "$type": "color", "$value": "{cor.primitivo.latao}" } },
      "acao":             { "fundo": { "$type": "color", "$value": "{cor.primitivo.argila}" },
                            "texto": { "$type": "color", "$value": "{cor.primitivo.linho}" },
                            "secundaria-borda": { "$type": "color", "$value": "{cor.primitivo.pinho}" } },
      "borda":            { "padrao": { "$type": "color", "$value": "#1E3B3329", "$description": "Pinho 16%." },
                            "forte": { "$type": "color", "$value": "{cor.primitivo.pinho}" } },
      "status":           { "tudo-certo": { "$type": "color", "$value": "{cor.primitivo.pinho}", "$description": "Relatório: ✓ tarefa feita." },
                            "atencao": { "$type": "color", "$value": "{cor.primitivo.argila}", "$description": "Relatório: observação para o tutor. Nunca vermelho de alarme." } }
    }
  },
  "fonte": {
    "familia": {
      "voz":    { "$type": "fontFamily", "$value": ["Literata", "Georgia", "Times New Roman", "serif"], "$description": "Títulos, frases de marca, citações. Itálico = afeto." },
      "metodo": { "$type": "fontFamily", "$value": ["Instrument Sans", "Helvetica Neue", "Arial", "sans-serif"], "$description": "Texto corrido, rótulos, dados, interface." }
    },
    "papel": {
      "display":  { "$type": "typography", "$value": { "fontFamily": "{fonte.familia.voz}", "fontWeight": 600, "fontSize": "56px", "lineHeight": 1.05, "letterSpacing": "-0.01em", "fontVariationSettings": "'opsz' 72" } },
      "titulo-1": { "$type": "typography", "$value": { "fontFamily": "{fonte.familia.voz}", "fontWeight": 600, "fontSize": "40px", "lineHeight": 1.1, "letterSpacing": "-0.005em", "fontVariationSettings": "'opsz' 48" } },
      "titulo-2": { "$type": "typography", "$value": { "fontFamily": "{fonte.familia.voz}", "fontWeight": 600, "fontSize": "30px", "lineHeight": 1.15, "letterSpacing": "0", "fontVariationSettings": "'opsz' 36" } },
      "titulo-3": { "$type": "typography", "$value": { "fontFamily": "{fonte.familia.voz}", "fontWeight": 600, "fontSize": "22px", "lineHeight": 1.25, "letterSpacing": "0", "fontVariationSettings": "'opsz' 24" } },
      "afeto":    { "$type": "typography", "$value": { "fontFamily": "{fonte.familia.voz}", "fontStyle": "italic", "fontWeight": 400, "fontSize": "22px", "lineHeight": 1.4, "letterSpacing": "0" }, "$description": "Frases da Cuidadora: 'Tudo certo por aqui.' Máx. 1 por peça." },
      "corpo":    { "$type": "typography", "$value": { "fontFamily": "{fonte.familia.metodo}", "fontWeight": 400, "fontSize": "17px", "lineHeight": 1.55, "letterSpacing": "0" } },
      "rotulo":   { "$type": "typography", "$value": { "fontFamily": "{fonte.familia.metodo}", "fontWeight": 600, "fontSize": "12px", "lineHeight": 1.2, "letterSpacing": "0.14em", "textTransform": "uppercase" } },
      "dado":     { "$type": "typography", "$value": { "fontFamily": "{fonte.familia.metodo}", "fontWeight": 500, "fontSize": "14px", "lineHeight": 1.4, "fontVariantNumeric": "tabular-nums" }, "$description": "Horários e registros do relatório." }
    },
    "social-1080": {
      "$description": "Escala para telas de 1080 px de largura (Instagram). Nada abaixo de 28 px.",
      "display":  { "$type": "dimension", "$value": "112px" },
      "titulo":   { "$type": "dimension", "$value": "76px" },
      "subtitulo":{ "$type": "dimension", "$value": "48px" },
      "corpo":    { "$type": "dimension", "$value": "36px" },
      "rotulo":   { "$type": "dimension", "$value": "28px" }
    }
  },
  "espaco": {
    "1": { "$type": "dimension", "$value": "4px" },  "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" }, "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" }, "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" }, "8": { "$type": "dimension", "$value": "64px" },
    "9": { "$type": "dimension", "$value": "96px" }, "10": { "$type": "dimension", "$value": "128px" }
  },
  "raio": {
    "sm": { "$type": "dimension", "$value": "6px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "20px" },
    "pilula": { "$type": "dimension", "$value": "999px" },
    "plaquinha": { "$type": "dimension", "$value": "50% 50% 22% 22% / 44.6% 44.6% 19.6% 19.6%", "$description": "Moldura em arco (proporção 100×112). Só para molduras de foto e selos, nunca em botões." }
  },
  "traco": {
    "borda": { "$type": "dimension", "$value": "1px" },
    "icone": { "$type": "dimension", "$value": "1.5px", "$description": "Em grade de 24 px." }
  },
  "sombra": { "$description": "A marca é plana: elevação por cor (Papel sobre Linho), não por sombra." },
  "movimento": {
    "duracao": {
      "micro":    { "$type": "duration", "$value": "160ms" },
      "padrao":   { "$type": "duration", "$value": "320ms" },
      "enfase":   { "$type": "duration", "$value": "720ms" },
      "assentar": { "$type": "duration", "$value": "1400ms", "$description": "Balanço da plaquinha até parar." }
    },
    "curva": {
      "firme":   { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1], "$description": "Entrada decidida, chegada suave. Padrão." },
      "saida":   { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1] },
      "assentar":{ "$type": "cubicBezier", "$value": [0.34, 1.2, 0.64, 1], "$description": "Pequeno excesso e calma. Só para a plaquinha." }
    }
  }
}
